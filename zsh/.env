# Sourced by .zshrc, so everything here must be zsh, not bash.

# Colourise grep output. GREP_OPTIONS was deprecated in grep 2.21 and is
# ignored by the grep macOS ships, so alias instead of exporting it.
alias grep='grep --color=auto'

# Case-insensitive globbing (used in pathname expansion).
# bash equivalent: shopt -s nocaseglob
setopt nocaseglob

# Offer to correct mistyped command names.
#
# This stands in for bash's "shopt -s cdspell", which silently fixed typos in
# cd paths. zsh has no direct equivalent: `correct` covers command names only,
# and `correctall` extends it to every argument of every command, which is
# intrusive. Swap in `setopt correctall` if you want cd paths corrected too.
setopt correct
